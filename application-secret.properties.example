# Template for application-secret.properties
# Copy this file to `application-secret.properties` and fill in the real values.
# The `-secret` suffix is git-ignored, so real credentials never get committed.
#
# Usage:
#   copy application-secret.properties.example application-secret.properties
#   (edit the copied file)

# Example secret properties (override defaults from application.properties):
# database.password=change-me
# api.api-key=change-me